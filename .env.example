# Copy this file to ".env" and fill in real values. NEVER commit ".env".
# Variables are added here as each phase needs them.
APP_ENV=development

# --- PostgreSQL ---
POSTGRES_USER=assistant
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=assistant_db
POSTGRES_PORT=5432

# --- Chroma (vector DB) ---
# Host port is 8001 because FastAPI uses 8000.
CHROMA_HOST=localhost
CHROMA_PORT=8001